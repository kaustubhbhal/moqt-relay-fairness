diff --git a/moq-relay-ietf/src/egress.rs b/moq-relay-ietf/src/egress.rs
new file mode 100644
index 0000000..3308249
--- /dev/null
+++ b/moq-relay-ietf/src/egress.rs
@@ -0,0 +1,412 @@
+// SPDX-FileCopyrightText: 2026 Cloudflare Inc. and contributors
+// SPDX-License-Identifier: MIT OR Apache-2.0
+
+//! Aggregate UDP-payload service budget, shared by every connection on a socket.
+//!
+//! ACKs, control packets, and retransmissions consume this budget. IP and link
+//! headers do not. This is not a physical-link emulator or a fair/FIFO scheduler.
+//! No packet payload is copied or queued here; Quinn retains blocked transmits.
+
+use std::{
+    future::Future,
+    io::{self, IoSliceMut},
+    net::SocketAddr,
+    pin::Pin,
+    sync::{Arc, Mutex},
+    task::{Context, Poll},
+    time::Duration,
+};
+
+use quinn::{
+    udp::{RecvMeta, Transmit},
+    AsyncUdpSocket, UdpPoller,
+};
+use tokio::time::{Instant, Sleep};
+
+const NANOS_PER_SECOND: u128 = 1_000_000_000;
+
+#[derive(Debug)]
+struct Bucket {
+    credit: u128,
+    updated: Instant,
+    // UdpPoller has no pending-transmit argument. Waiting for the largest
+    // previously throttled datagram avoids waking at every single-byte refill.
+    // A smaller sender may wait longer; no per-connection fairness is promised.
+    readiness_bytes: usize,
+}
+
+/// A Tokio-backed rate limiter for a single shared Quinn UDP socket.
+#[derive(Debug)]
+pub struct EgressSocket {
+    inner: Arc<dyn AsyncUdpSocket>,
+    rate: u64,
+    burst: usize,
+    bucket: Mutex<Bucket>,
+}
+
+impl EgressSocket {
+    /// Start with a full bucket. A 65,536-byte burst admits any normal UDP
+    /// datagram; smaller bursts are allowed but oversized sends fail explicitly.
+    pub fn wrap(
+        inner: Arc<dyn AsyncUdpSocket>,
+        bytes_per_second: u64,
+        burst_bytes: usize,
+    ) -> io::Result<Arc<dyn AsyncUdpSocket>> {
+        if bytes_per_second == 0 || burst_bytes == 0 {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "egress rate and burst must be positive",
+            ));
+        }
+        metrics::gauge!("moq_relay_egress_limit_bytes_per_second").set(bytes_per_second as f64);
+        metrics::gauge!("moq_relay_egress_burst_bytes").set(burst_bytes as f64);
+        Ok(Arc::new(Self {
+            inner,
+            rate: bytes_per_second,
+            burst: burst_bytes,
+            bucket: Mutex::new(Bucket {
+                credit: burst_bytes as u128 * NANOS_PER_SECOND,
+                updated: Instant::now(),
+                readiness_bytes: 1,
+            }),
+        }))
+    }
+
+    fn refill(&self, bucket: &mut Bucket, now: Instant) {
+        let elapsed = now.duration_since(bucket.updated).as_nanos();
+        bucket.credit = bucket
+            .credit
+            .saturating_add(elapsed.saturating_mul(self.rate as u128))
+            .min(self.burst as u128 * NANOS_PER_SECOND);
+        bucket.updated = now;
+    }
+
+    fn ready_deadline(&self) -> io::Result<Option<Instant>> {
+        let mut bucket = self
+            .bucket
+            .lock()
+            .map_err(|_| io::Error::other("egress bucket lock poisoned"))?;
+        let now = Instant::now();
+        self.refill(&mut bucket, now);
+        let required = bucket.readiness_bytes as u128 * NANOS_PER_SECOND;
+        if bucket.credit >= required {
+            return Ok(None);
+        }
+        let nanos = (required - bucket.credit).div_ceil(self.rate as u128);
+        // readiness_bytes never exceeds a legal datagram, so this is at most
+        // 65,535 seconds even at one byte/second. Ceil preserves low-rate wakes.
+        let delay = Duration::new(
+            (nanos / NANOS_PER_SECOND) as u64,
+            (nanos % NANOS_PER_SECOND) as u32,
+        );
+        Ok(Some(now + delay))
+    }
+}
+
+impl AsyncUdpSocket for EgressSocket {
+    fn create_io_poller(self: Arc<Self>) -> Pin<Box<dyn UdpPoller>> {
+        let inner = self.inner.clone().create_io_poller();
+        Box::pin(EgressPoller {
+            socket: self,
+            inner,
+            sleep: None,
+        })
+    }
+
+    fn try_send(&self, transmit: &Transmit<'_>) -> io::Result<()> {
+        let bytes = transmit.contents.len();
+        if bytes > self.burst || bytes > u16::MAX as usize {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "UDP transmit exceeds egress burst or datagram size",
+            ));
+        }
+        if transmit.segment_size.is_some_and(|size| size < bytes) {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "egress shaper does not accept segmented UDP transmits",
+            ));
+        }
+        let mut bucket = self
+            .bucket
+            .lock()
+            .map_err(|_| io::Error::other("egress bucket lock poisoned"))?;
+        self.refill(&mut bucket, Instant::now());
+        let charge = bytes as u128 * NANOS_PER_SECOND;
+        if bucket.credit < charge {
+            bucket.readiness_bytes = bucket.readiness_bytes.max(bytes);
+            metrics::counter!("moq_relay_egress_throttled_total").increment(1);
+            return Err(io::ErrorKind::WouldBlock.into());
+        }
+        // Nonblocking send under the short mutex makes successful sends and
+        // charges atomic across connections. Failed OS sends spend no credit.
+        self.inner.try_send(transmit)?;
+        bucket.credit -= charge;
+        metrics::counter!("moq_relay_egress_udp_bytes_total").increment(bytes as u64);
+        Ok(())
+    }
+
+    fn poll_recv(
+        &self,
+        cx: &mut Context<'_>,
+        bufs: &mut [IoSliceMut<'_>],
+        meta: &mut [RecvMeta],
+    ) -> Poll<io::Result<usize>> {
+        self.inner.poll_recv(cx, bufs, meta)
+    }
+
+    fn local_addr(&self) -> io::Result<SocketAddr> {
+        self.inner.local_addr()
+    }
+
+    fn max_transmit_segments(&self) -> usize {
+        1
+    }
+
+    fn max_receive_segments(&self) -> usize {
+        self.inner.max_receive_segments()
+    }
+
+    fn may_fragment(&self) -> bool {
+        self.inner.may_fragment()
+    }
+}
+
+#[derive(Debug)]
+struct EgressPoller {
+    socket: Arc<EgressSocket>,
+    inner: Pin<Box<dyn UdpPoller>>,
+    sleep: Option<Pin<Box<Sleep>>>,
+}
+
+impl UdpPoller for EgressPoller {
+    fn poll_writable(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        let this = self.get_mut();
+        // Register the OS wake even while rate-blocked. Every Quinn connection
+        // owns a distinct inner poller and timer, so no task overwrites another.
+        let inner = this.inner.as_mut().poll_writable(cx);
+        if let Poll::Ready(Err(error)) = inner {
+            return Poll::Ready(Err(error));
+        }
+        match this.socket.ready_deadline()? {
+            None => {
+                this.sleep = None;
+                inner
+            }
+            Some(deadline) => {
+                let timer = this
+                    .sleep
+                    .get_or_insert_with(|| Box::pin(tokio::time::sleep_until(deadline)));
+                timer.as_mut().reset(deadline);
+                if timer.as_mut().poll(cx).is_ready() {
+                    // The deadline can pass between accounting and registration.
+                    // Re-poll instead of losing that wake; the next accounting
+                    // pass decides whether another connection spent the credit.
+                    cx.waker().wake_by_ref();
+                }
+                Poll::Pending
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use futures::{future::poll_fn, task::AtomicWaker};
+    use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+    #[derive(Debug)]
+    struct FakeSocket {
+        writable: AtomicBool,
+        sent: AtomicU64,
+        waiters: Mutex<Vec<Arc<AtomicWaker>>>,
+    }
+
+    impl FakeSocket {
+        fn new() -> Arc<Self> {
+            Arc::new(Self {
+                writable: AtomicBool::new(true),
+                sent: AtomicU64::new(0),
+                waiters: Mutex::new(Vec::new()),
+            })
+        }
+
+        fn set_writable(&self, value: bool) {
+            self.writable.store(value, Ordering::SeqCst);
+            if value {
+                for waiter in self.waiters.lock().unwrap().iter() {
+                    waiter.wake();
+                }
+            }
+        }
+    }
+
+    impl AsyncUdpSocket for FakeSocket {
+        fn create_io_poller(self: Arc<Self>) -> Pin<Box<dyn UdpPoller>> {
+            let waker = Arc::new(AtomicWaker::new());
+            self.waiters.lock().unwrap().push(waker.clone());
+            Box::pin(FakePoller {
+                socket: self,
+                waker,
+            })
+        }
+
+        fn try_send(&self, transmit: &Transmit<'_>) -> io::Result<()> {
+            if !self.writable.load(Ordering::SeqCst) {
+                return Err(io::ErrorKind::WouldBlock.into());
+            }
+            self.sent
+                .fetch_add(transmit.contents.len() as u64, Ordering::SeqCst);
+            Ok(())
+        }
+
+        fn poll_recv(
+            &self,
+            _cx: &mut Context<'_>,
+            _bufs: &mut [IoSliceMut<'_>],
+            _meta: &mut [RecvMeta],
+        ) -> Poll<io::Result<usize>> {
+            Poll::Pending
+        }
+
+        fn local_addr(&self) -> io::Result<SocketAddr> {
+            Ok("127.0.0.1:4443".parse().unwrap())
+        }
+    }
+
+    #[derive(Debug)]
+    struct FakePoller {
+        socket: Arc<FakeSocket>,
+        waker: Arc<AtomicWaker>,
+    }
+
+    impl UdpPoller for FakePoller {
+        fn poll_writable(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+            self.waker.register(cx.waker());
+            if self.socket.writable.load(Ordering::SeqCst) {
+                Poll::Ready(Ok(()))
+            } else {
+                Poll::Pending
+            }
+        }
+    }
+
+    fn transmit(contents: &[u8]) -> Transmit<'_> {
+        Transmit {
+            destination: "127.0.0.1:4444".parse().unwrap(),
+            ecn: None,
+            contents,
+            segment_size: None,
+            src_ip: None,
+        }
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn aggregate_envelope_and_fractional_refills() {
+        let inner = FakeSocket::new();
+        let socket = EgressSocket::wrap(inner.clone(), 100, 100).unwrap();
+        socket.try_send(&transmit(&[0; 100])).unwrap();
+        assert_eq!(
+            socket.try_send(&transmit(&[0])).unwrap_err().kind(),
+            io::ErrorKind::WouldBlock
+        );
+        for step in 1..=100 {
+            tokio::time::advance(Duration::from_millis(10)).await;
+            socket.try_send(&transmit(&[0])).unwrap();
+            assert!(inner.sent.load(Ordering::SeqCst) <= 100 + step);
+            assert!(socket.try_send(&transmit(&[0])).is_err());
+        }
+        assert_eq!(inner.sent.load(Ordering::SeqCst), 200);
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn failed_inner_send_spends_no_credit() {
+        let inner = FakeSocket::new();
+        let socket = EgressSocket::wrap(inner.clone(), 1, 100).unwrap();
+        inner.set_writable(false);
+        assert_eq!(
+            socket.try_send(&transmit(&[0; 100])).unwrap_err().kind(),
+            io::ErrorKind::WouldBlock
+        );
+        assert_eq!(inner.sent.load(Ordering::SeqCst), 0);
+        inner.set_writable(true);
+        socket.try_send(&transmit(&[0; 100])).unwrap();
+        assert_eq!(inner.sent.load(Ordering::SeqCst), 100);
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn low_rate_timer_and_inner_readiness_both_wake() {
+        let inner = FakeSocket::new();
+        let socket = EgressSocket::wrap(inner.clone(), 1, 10).unwrap();
+        socket.try_send(&transmit(&[0; 10])).unwrap();
+        assert!(socket.try_send(&transmit(&[0; 10])).is_err());
+        let mut poller = socket.clone().create_io_poller();
+        inner.set_writable(false);
+        let task =
+            tokio::spawn(async move { poll_fn(|cx| poller.as_mut().poll_writable(cx)).await });
+        tokio::task::yield_now().await;
+        tokio::time::advance(Duration::from_secs(9)).await;
+        assert!(!task.is_finished());
+        tokio::time::advance(Duration::from_secs(1)).await;
+        tokio::task::yield_now().await;
+        assert!(!task.is_finished());
+        inner.set_writable(true);
+        task.await.unwrap().unwrap();
+        socket.try_send(&transmit(&[0; 10])).unwrap();
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn invalid_or_oversized_transmit_fails_without_waiting() {
+        let inner = FakeSocket::new();
+        assert!(EgressSocket::wrap(inner.clone(), 0, 100).is_err());
+        assert!(EgressSocket::wrap(inner.clone(), 100, 0).is_err());
+        let socket = EgressSocket::wrap(inner.clone(), 1, 10).unwrap();
+        assert_eq!(socket.max_transmit_segments(), 1);
+        assert_eq!(
+            socket.try_send(&transmit(&[0; 11])).unwrap_err().kind(),
+            io::ErrorKind::InvalidInput
+        );
+        let mut segmented = transmit(&[0; 10]);
+        segmented.segment_size = Some(5);
+        assert_eq!(
+            socket.try_send(&segmented).unwrap_err().kind(),
+            io::ErrorKind::InvalidInput
+        );
+        socket.try_send(&transmit(&[0; 10])).unwrap();
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn multiple_pollers_share_one_sustained_budget() {
+        let inner = FakeSocket::new();
+        let socket = EgressSocket::wrap(inner.clone(), 100, 10).unwrap();
+        let start = Instant::now();
+        let mut tasks = Vec::new();
+        for _ in 0..4 {
+            let socket = socket.clone();
+            tasks.push(tokio::spawn(async move {
+                let mut poller = socket.clone().create_io_poller();
+                for _ in 0..5 {
+                    loop {
+                        match socket.try_send(&transmit(&[0; 10])) {
+                            Ok(()) => break,
+                            Err(error) if error.kind() == io::ErrorKind::WouldBlock => {
+                                poll_fn(|cx| poller.as_mut().poll_writable(cx))
+                                    .await
+                                    .unwrap();
+                            }
+                            Err(error) => panic!("unexpected send error: {error}"),
+                        }
+                    }
+                }
+            }));
+        }
+        for task in tasks {
+            task.await.unwrap();
+        }
+        let elapsed = Instant::now().duration_since(start).as_nanos();
+        assert_eq!(inner.sent.load(Ordering::SeqCst), 200);
+        assert!(elapsed >= 1_900_000_000);
+        assert!(200 * NANOS_PER_SECOND <= 10 * NANOS_PER_SECOND + 100 * elapsed);
+    }
+}
