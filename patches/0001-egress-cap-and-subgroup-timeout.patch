+// Exercise the public Subscribed builder, PUBLISH_DONE path, and real QUIC
+// resource cleanup, rather than checking only the generic timer helper.
+async fn subgroup_lifetime_terminates_subscription(block_open: bool) {
+    let (sender, receiver, observer, proxy) =
+        pair_with_limits(true, true, if block_open { Some(0) } else { None }).await;
+    proxy.1.store(true, Ordering::SeqCst);
+    let (outgoing, mut messages) = crate::watch::Queue::default().split();
+    let publisher = Publisher::new(
+        outgoing,
+        sender,
+        None,
+        crate::session::RequestId::new(0, u64::MAX, u64::MAX, 1),
+        crate::session::PendingRequests::default(),
+        crate::session::SessionId::generate(),
+        tokio_util::sync::CancellationToken::new(),
+    );
+    let namespace = crate::coding::TrackNamespace::from_utf8_path("timeout-test");
+    let (writer, reader) = serve::Track::new(namespace.clone(), "track").produce();
+    let mut writer = writer.subgroups().unwrap();
+    let mut group = writer.append(128).unwrap();
+    group.write(bytes::Bytes::from_static(b"deadline")).unwrap();
+    drop(group);
+    let (subscribed, _recv, _joining) = Subscribed::new(
+        publisher.clone(),
+        message::Subscribe {
+            id: 0,
+            track_namespace: namespace,
+            track_name: "track".into(),
+            params: Default::default(),
+        },
+        None,
+    )
+    .unwrap();
+    let serve = subscribed
+        .with_subgroup_timeout(Some(Duration::from_millis(300)))
+        .serve(reader);
+    let control = async {
+        assert!(matches!(
+            messages.pop().await,
+            Some(message::Message::SubscribeOk(_))
+        ));
+        let Some(message::Message::PublishDone(done)) = messages.pop().await else {
+            panic!("expected terminal PUBLISH_DONE");
+        };
+        assert_eq!(
+            done.status_code,
+            message::PublishDoneCode::TooFarBehind as u64
+        );
+        assert_eq!(done.stream_count, if block_open { 0 } else { 1 });
+    };
+    let receive = async {
+        if block_open {
+            return;
+        }
+        let mut stream = receiver.accept_uni().await.unwrap();
+        let mut bytes = 0;
+        while let Some(chunk) = stream.read(65536).await.unwrap() {
+            bytes += chunk.len();
+        }
+        assert!(
+            bytes > 8,
+            "all data and FIN arrive while their ACK is suppressed"
+        );
