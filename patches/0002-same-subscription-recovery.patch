+/// Preserve one absolute deadline across stream opening, writing, and FIN ACK.
+/// Dropping a timed-out write/ACK future drops its existing stream reset guard.
+#[cfg(test)]
+async fn with_subgroup_deadline<T>(
+    deadline: Option<Instant>,
+    future: impl Future<Output = Result<T, SessionError>>,
+) -> Result<T, SessionError> {
+    with_subgroup_deadline_and_reset(deadline, None, future).await
+}
+
+async fn with_subgroup_deadline_and_reset<T>(
+    deadline: Option<Instant>,
+    expiry_reset: Option<Arc<AtomicBool>>,
+    future: impl Future<Output = Result<T, SessionError>>,
+) -> Result<T, SessionError> {
+    // Keep the underlying future alive until the reset reason is recorded.
+    // Passing it by value to timeout_at would drop its guard too early.
+    tokio::pin!(future);
+    match deadline {
+        Some(deadline) => match timeout_at(deadline, &mut future).await {
+            Ok(result) => result,
+            Err(_) => {
+                if let Some(flag) = expiry_reset {
+                    flag.store(true, Ordering::Release);
+                }
+                Err(ServeError::Closed(message::PublishDoneCode::TooFarBehind as u64).into())
+            }
+        },
+        None => future.await,
+    }
+}
