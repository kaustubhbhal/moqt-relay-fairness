+    /// Select a local forwarding-lifetime policy for downstream subscriptions.
+    pub(crate) fn with_subgroup_timeout(mut self, timeout: Option<Duration>) -> Self {
+        self.subgroup_timeout = timeout;
+        self
+    }
+
+    pub(crate) fn with_subgroup_skip(mut self, enabled: bool) -> Self {
+        self.subgroup_skip = enabled;
+        self
+    }
+
+    async fn serve_track(
+        &self,
+        subscribed: Subscribed,
+        track: TrackReader,
+    ) -> Result<(), SessionError> {
+        let subscription_id = subscribed.id;
+        // Draft-16 9.2.2.2 permits early abandonment only when a delivery
+        // timeout is specified. This local group timer is intentionally not a
+        // full implementation of the per-Object header-receipt deadline.
+        let permitted_timeout = subscribed.params.get(0x02).and_then(|kv| match kv.value {
+            moq_transport::coding::Value::IntValue(ms) if ms > 0 => Some(Duration::from_millis(ms)),
+            _ => None,
+        });
+        let skip = self.subgroup_skip && permitted_timeout.is_some();
+        let timeout = match (self.subgroup_timeout, permitted_timeout) {
+            (Some(local), Some(peer)) if skip => Some(local.min(peer)),
+            (configured, _) => configured,
+        };
+        let result = subscribed
+            .with_subgroup_timeout(timeout)
+            .with_subgroup_skip(skip)
+            .with_subgroup_resync_observer(std::sync::Arc::new(|abandoned| {
+                metrics::counter!("moq_relay_live_resync_total").increment(1);
+                metrics::counter!("moq_relay_subgroups_abandoned_total")
+                    .increment(abandoned as u64);
+            }))
+            .serve(track)
+            .await;
+        if matches!(&result, Err(SessionError::Serve(ServeError::Closed(code)))
+            if *code == moq_transport::message::PublishDoneCode::TooFarBehind as u64)
