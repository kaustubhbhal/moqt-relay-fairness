@@ -0,0 +1,378 @@
+// SPDX-FileCopyrightText: 2026 MoQT Relay Fairness project contributors
+// SPDX-License-Identifier: MIT OR Apache-2.0
+
+//! Application-byte DRR. The transport is polled without waiting while a turn
+//! is held; a blocked stream becomes eligible again only on its transport wake.
+use futures::task::{waker, ArcWake};
+use moq_transport::session::{
+    ScheduledWrite, SessionError, SharedWritePolicy, WriteAttempt, WritePolicy,
+};
+use std::{
+    collections::{BTreeMap, VecDeque},
+    future::Future,
+    pin::Pin,
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        Arc, Mutex,
+    },
+    task::{Context, Poll, Waker},
+};
+use tokio::time::{Duration, Instant, Sleep};
+
+const CHUNK: usize = 8192;
+const QUANTUM: usize = 16384;
+#[derive(Clone)]
+pub struct Scheduler {
+    state: Arc<Mutex<State>>,
+}
+struct State {
+    drr: bool,
+    rate: f64,
+    tokens: f64,
+    burst: f64,
+    last: Instant,
+    timer: Option<Pin<Box<Sleep>>>,
+    next: u64,
+    sequence: u64,
+    requests: BTreeMap<u64, Request>,
+    flows: BTreeMap<String, Flow>,
+    ring: VecDeque<String>,
+}
+struct Flow {
+    deficit: usize,
+    started: bool,
+}
+struct Request {
+    session: String,
+    priority: u16,
+    remaining: usize,
+    ready: Arc<AtomicBool>,
+    sequence: u64,
+    wake: Waker,
+}
+struct SessionPolicy {
+    scheduler: Scheduler,
+    session: String,
+}
+struct StreamPolicy {
+    scheduler: Scheduler,
+    session: String,
+    priority: u16,
+    id: u64,
+}
+struct TransportWake {
+    ready: Arc<AtomicBool>,
+    task: Waker,
+}
+impl ArcWake for TransportWake {
+    fn wake_by_ref(this: &Arc<Self>) {
+        // Transport may wake synchronously while being polled. Never take the
+        // scheduler mutex here, or a blocked write can deadlock every session.
+        this.ready.store(true, Ordering::Release);
+        this.task.wake_by_ref();
+    }
+}
+impl State {
+    fn rotate(&mut self) {
+        if let Some(key) = self.ring.pop_front() {
+            self.ring.push_back(key);
+        }
+    }
+    fn select(&mut self) -> Option<u64> {
+        if !self.drr {
+            return self
+                .requests
+                .iter()
+                .filter(|(_, r)| r.ready.load(Ordering::Acquire) && r.remaining > 0)
+                .min_by_key(|(_, r)| r.sequence)
+                .map(|(id, _)| *id);
+        }
+        for _ in 0..self.ring.len() * 2 {
+            let key = self.ring.front()?.clone();
+            let choice = self
+                .requests
+                .iter()
+                .filter(|(_, r)| {
+                    r.session == key && r.ready.load(Ordering::Acquire) && r.remaining > 0
+                })
+                .min_by_key(|(_, r)| (r.priority, r.sequence))
+                .map(|(id, r)| (*id, r.remaining.min(CHUNK)));
+            let flow = self.flows.get_mut(&key).unwrap();
+            let Some((id, size)) = choice else {
+                self.rotate();
+                continue;
+            };
+            if !flow.started {
+                flow.deficit += QUANTUM;
+                flow.started = true;
+            }
+            if flow.deficit >= size {
+                return Some(id);
+            }
+            flow.started = false;
+            self.rotate();
+        }
+        None
+    }
+    fn wake_next(&mut self) {
+        if let Some(id) = self.select() {
+            self.requests[&id].wake.wake_by_ref();
+        }
+    }
+    fn remove(&mut self, id: u64) {
+        if let Some(r) = self.requests.remove(&id) {
+            if !self.requests.values().any(|x| x.session == r.session) {
+                self.flows.remove(&r.session);
+                self.ring.retain(|s| s != &r.session);
+            }
+        }
+        self.wake_next();
+    }
+}
+impl Scheduler {
+    pub fn new(bytes_per_second: u64, drr: bool) -> Self {
+        assert!(bytes_per_second > 0);
+        Self {
+            state: Arc::new(Mutex::new(State {
+                drr,
+                rate: bytes_per_second as f64,
+                tokens: QUANTUM as f64,
+                burst: QUANTUM as f64,
+                last: Instant::now(),
+                timer: None,
+                next: 0,
+                sequence: 0,
+                requests: BTreeMap::new(),
+                flows: BTreeMap::new(),
+                ring: VecDeque::new(),
+            })),
+        }
+    }
+    pub fn session(&self, session: String) -> SharedWritePolicy {
+        Arc::new(SessionPolicy {
+            scheduler: self.clone(),
+            session,
+        })
+    }
+}
+impl WritePolicy for SessionPolicy {
+    fn stream(&self, priority: u16) -> Box<dyn ScheduledWrite> {
+        let mut state = self.scheduler.state.lock().unwrap();
+        let id = state.next;
+        state.next += 1;
+        Box::new(StreamPolicy {
+            scheduler: self.scheduler.clone(),
+            session: self.session.clone(),
+            priority,
+            id,
+        })
+    }
+}
+impl ScheduledWrite for StreamPolicy {
+    fn poll_write(
+        &mut self,
+        cx: &mut Context<'_>,
+        available: usize,
+        attempt: &mut WriteAttempt<'_>,
+    ) -> Poll<Result<usize, SessionError>> {
+        if available == 0 {
+            return Poll::Ready(Ok(0));
+        }
+        let mut state = self.scheduler.state.lock().unwrap();
+        let sequence = state.sequence;
+        state.sequence += 1;
+        if !state.flows.contains_key(&self.session) {
+            state.ring.push_back(self.session.clone());
+            state.flows.insert(
+                self.session.clone(),
+                Flow {
+                    deficit: 0,
+                    started: false,
+                },
+            );
+        }
+        let req = state.requests.entry(self.id).or_insert_with(|| Request {
+            session: self.session.clone(),
+            priority: self.priority,
+            remaining: available,
+            ready: Arc::new(AtomicBool::new(true)),
+            sequence,
+            wake: cx.waker().clone(),
+        });
+        if req.remaining == 0 {
+            req.ready.store(true, Ordering::Release);
+            req.sequence = sequence;
+        }
+        req.remaining = available;
+        req.wake = cx.waker().clone();
+        if state.select() != Some(self.id) {
+            state.wake_next();
+            return Poll::Pending;
+        }
+        let now = Instant::now();
+        state.tokens = (state.tokens + now.duration_since(state.last).as_secs_f64() * state.rate)
+            .min(state.burst);
+        state.last = now;
+        let size = available.min(CHUNK);
+        if state.tokens < size as f64 {
+            let deadline = now + Duration::from_secs_f64((size as f64 - state.tokens) / state.rate);
+            let timer = state
+                .timer
+                .get_or_insert_with(|| Box::pin(tokio::time::sleep_until(deadline)));
+            timer.as_mut().reset(deadline);
+            let _ = timer.as_mut().poll(cx);
+            return Poll::Pending;
+        }
+        let ready = state.requests[&self.id].ready.clone();
+        ready.store(false, Ordering::Release);
+        let transport_waker = waker(Arc::new(TransportWake {
+            ready,
+            task: cx.waker().clone(),
+        }));
+        let result = attempt(&mut Context::from_waker(&transport_waker), size);
+        match result {
+            Poll::Ready(Ok(n)) => {
+                assert!(n <= size, "transport accepted beyond offered slice");
+                state.tokens -= n as f64;
+                if state.drr {
+                    state.flows.get_mut(&self.session).unwrap().deficit -= n;
+                }
+                let seq = state.sequence;
+                state.sequence += 1;
+                let req = state.requests.get_mut(&self.id).unwrap();
+                req.remaining = available - n;
+                req.ready.store(req.remaining > 0, Ordering::Release);
+                req.sequence = seq;
+                metrics::counter!("moq_relay_scheduled_bytes_total", "session" => self.session.clone()).increment(n as u64);
+                // Keep bounded residual credit across header/payload await gaps;
+                // never accumulate rounds while a session has no ready writes.
+                state.wake_next();
+                Poll::Ready(Ok(n))
+            }
+            Poll::Ready(Err(err)) => {
+                state.remove(self.id);
+                Poll::Ready(Err(err))
+            }
+            Poll::Pending => {
+                // A synchronous transport wake may already have restored readiness.
+                metrics::counter!("moq_relay_scheduler_blocked_total").increment(1);
+                state.wake_next();
+                Poll::Pending
+            }
+        }
+    }
+}
+impl Drop for StreamPolicy {
+    fn drop(&mut self) {
+        self.scheduler.state.lock().unwrap().remove(self.id);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use futures::task::noop_waker;
+    #[tokio::test]
+    async fn byte_deficits_ignore_track_count_and_respect_priority() {
+        let scheduler = Scheduler::new(1_000_000_000, true);
+        let wake = noop_waker();
+        let mut s = scheduler.state.lock().unwrap();
+        for (id, key, priority, size) in [
+            (0, "a", 9, 1024),
+            (1, "a", 0, 4096),
+            (2, "a", 9, 8192),
+            (3, "b", 0, 8192),
+        ] {
+            s.requests.insert(
+                id,
+                Request {
+                    session: key.into(),
+                    priority,
+                    remaining: size,
+                    ready: Arc::new(AtomicBool::new(true)),
+                    sequence: id,
+                    wake: wake.clone(),
+                },
+            );
+            if !s.flows.contains_key(key) {
+                s.flows.insert(
+                    key.into(),
+                    Flow {
+                        deficit: 0,
+                        started: false,
+                    },
+                );
+                s.ring.push_back(key.into());
+            }
+        }
+        let mut bytes = BTreeMap::<String, usize>::new();
+        for _ in 0..1200 {
+            let id = s.select().unwrap();
+            let r = &s.requests[&id];
+            let key = r.session.clone();
+            let n = r.remaining.min(CHUNK);
+            if key == "a" {
+                assert_eq!(id, 1, "priority applies inside the session");
+            }
+            *bytes.entry(key.clone()).or_default() += n;
+            s.flows.get_mut(&key).unwrap().deficit -= n;
+        }
+        assert!((bytes["a"] as i64 - bytes["b"] as i64).unsigned_abs() <= QUANTUM as u64);
+    }
+    #[tokio::test]
+    async fn blocked_write_charges_nothing_and_other_session_runs() {
+        let s = Scheduler::new(1_000_000_000, true);
+        let mut a = s.session("a".into()).stream(0);
+        let mut b = s.session("b".into()).stream(0);
+        let w = noop_waker();
+        let mut cx = Context::from_waker(&w);
+        let mut transport = None;
+        assert!(a
+            .poll_write(&mut cx, 4096, &mut |cx, _| {
+                transport = Some(cx.waker().clone());
+                Poll::Pending
+            })
+            .is_pending());
+        assert!(matches!(
+            b.poll_write(&mut cx, 8192, &mut |_, n| Poll::Ready(Ok(n))),
+            Poll::Ready(Ok(8192))
+        ));
+        transport.unwrap().wake();
+        assert!(matches!(
+            a.poll_write(&mut cx, 4096, &mut |_, n| Poll::Ready(Ok(n))),
+            Poll::Ready(Ok(4096))
