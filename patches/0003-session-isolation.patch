+// SPDX-FileCopyrightText: 2026 MoQT Relay Fairness project contributors
+// SPDX-License-Identifier: MIT OR Apache-2.0
+
+use super::SessionError;
+use std::{
+    sync::Arc,
+    task::{Context, Poll},
+};
+
+/// Embedder-owned scheduling. Only subgroup media writes use this hook;
+/// control streams remain independent so resource pressure cannot block cleanup.
+pub trait WritePolicy: Send + Sync {
+    fn stream(&self, priority: u16) -> Box<dyn ScheduledWrite>;
+}
+
+pub type WriteAttempt<'a> =
+    dyn FnMut(&mut Context<'_>, usize) -> Poll<Result<usize, SessionError>> + 'a;
+
+pub trait ScheduledWrite: Send + Sync {
+    /// Charge only the bytes accepted by the nonblocking transport attempt.
+    fn poll_write(
+        &mut self,
+        cx: &mut Context<'_>,
+        available: usize,
+        attempt: &mut WriteAttempt<'_>,
+    ) -> Poll<Result<usize, SessionError>>;
+}
+
+pub type SharedWritePolicy = Arc<dyn WritePolicy>;
