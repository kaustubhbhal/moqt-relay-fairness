+// Exercise the full Subscribed control lifecycle over actual QUIC: expiry must
+// reset obsolete streams and keep this request alive for a later live group.
+async fn subgroup_skip_recovers(block_open: bool, pending_source: bool) {
+    let (sender, receiver, observer, proxy) =
+        pair_with_limits(true, true, Some(if block_open { 0 } else { 1 })).await;
+    proxy.1.store(true, Ordering::SeqCst);
+    let (outgoing, mut messages) = crate::watch::Queue::default().split();
+    let publisher = Publisher::new(
+        outgoing,
+        sender,
+        None,
+        crate::session::RequestId::new(0, u64::MAX, u64::MAX, 1),
+        crate::session::PendingRequests::default(),
+        crate::session::SessionId::generate(),
+        tokio_util::sync::CancellationToken::new(),
+    );
+    let namespace = crate::coding::TrackNamespace::from_utf8_path("skip-test");
+    let (writer, reader) = serve::Track::new(namespace.clone(), "track").produce();
+    let mut writer = writer.subgroups().unwrap();
+    let mut group = writer.append(128).unwrap();
+    // Larger than the receiver's window: FIN cannot arrive, so closed() exposes
+    // the actual reset code even though the sender can enqueue all payload.
+    group
+        .write(bytes::Bytes::from(vec![7; 3 * PAYLOAD]))
+        .unwrap();
+    // Keeping the source open covers cancellation of an active forwarding
+    // future, before its output can be handed to the FIN-ACK wait set.
+    let source_guard = pending_source.then_some(group);
+    let (subscribed, mut cancel, _joining) = Subscribed::new(
+        publisher.clone(),
+        message::Subscribe {
+            id: 0,
+            track_namespace: namespace,
+            track_name: "track".into(),
+            params: Default::default(),
+        },
+        None,
+    )
+    .unwrap();
+    let state = subscribed.forwarder.state.clone();
+    let (resync_send, mut resync_recv) = tokio::sync::mpsc::unbounded_channel();
+    let serve = subscribed
+        .with_subgroup_timeout(Some(Duration::from_millis(500)))
+        .with_subgroup_skip(true)
+        .with_subgroup_resync_observer(Arc::new(move |count| {
+            resync_send.send(count).unwrap();
+        }))
+        .serve(reader);
+    let exercise = async {
+        assert!(matches!(
+            messages.pop().await,
+            Some(message::Message::SubscribeOk(_))
+        ));
+        let stale = if block_open {
+            None
+        } else {
+            let stream = receiver.accept_uni().await.unwrap();
+            // With only one stream credit this second tracked subgroup cannot
+            // open; the same expiry must abandon it as well as the ACK waiter.
+            let mut queued = writer.append(128).unwrap();
+            queued
+                .write(bytes::Bytes::from_static(b"must-not-reopen"))
+                .unwrap();
+            drop(queued);
+            Some(stream)
+        };
+        let count = resync_recv.recv().await.unwrap();
+        drop(source_guard);
+        assert_eq!(count, if block_open { 1 } else { 2 });
+        assert_eq!(state.lock().stream_count, if block_open { 0 } else { 1 });
+        if let Some(mut stream) = stale {
+            assert_eq!(
+                stream.closed().await.unwrap(),
+                Some(u32::from(DataStreamResetCode::DeliveryTimeout) as u8)
+            );
+        } else {
+            assert_eq!(observer.stats().frame_rx.reset_stream, 0);
+        }
+        proxy.1.store(false, Ordering::SeqCst);
+        if block_open {
+            observer.set_max_concurrent_uni_streams(1u32.into());
+        }
+        let mut fresh = writer.append(128).unwrap();
+        fresh
+            .write(bytes::Bytes::from_static(b"fresh-after-resync"))
+            .unwrap();
+        drop(fresh);
+        let mut stream = receiver.accept_uni().await.unwrap();
+        let mut received = Vec::new();
+        while let Some(chunk) = stream.read(65536).await.unwrap() {
+            received.extend_from_slice(&chunk);
+        }
+        assert!(received.ends_with(b"fresh-after-resync"));
+        assert_eq!(state.lock().stream_count, if block_open { 1 } else { 2 });
+        // A successful skip must not send PUBLISH_DONE or require SUBSCRIBE again.
+        assert!(
+            tokio::time::timeout(Duration::from_millis(20), messages.pop())
+                .await
+                .is_err()
+        );
+        assert!(resync_recv.try_recv().is_err());
+        cancel.recv_unsubscribe().unwrap();
+    };
+    tokio::time::timeout(Duration::from_secs(5), async {
+        let (result, ()) = tokio::join!(serve, exercise);
+        assert!(matches!(
+            result,
+            Err(SessionError::Serve(ServeError::Cancel))
+        ));
+    })
+    .await
+    .expect("skip must release stale work and deliver a fresh group on the same request");
+}
