diff --git a/moq-relay-ietf/src/resources.rs b/moq-relay-ietf/src/resources.rs
new file mode 100644
index 0000000..6542de3
--- /dev/null
+++ b/moq-relay-ietf/src/resources.rs
@@ -0,0 +1,152 @@
+// SPDX-FileCopyrightText: 2026 MoQT Relay Fairness project contributors
+// SPDX-License-Identifier: MIT OR Apache-2.0
+
+use crate::scheduler::Scheduler;
+use moq_transport::{
+    serve::ByteBudget,
+    session::{SharedWritePolicy, Subscriber},
+};
+use std::sync::Arc;
+
+#[derive(Clone)]
+pub struct Resources {
+    scheduler: Option<Scheduler>,
+    global: Option<ByteBudget>,
+    session_limit: usize,
+    max_group: usize,
+}
+impl Resources {
+    pub fn new(
+        rate: Option<u64>,
+        drr: bool,
+        session_limit: usize,
+        global_limit: usize,
+        max_group: usize,
+    ) -> anyhow::Result<Self> {
+        anyhow::ensure!(rate != Some(0), "application rate must be positive");
+        anyhow::ensure!(!drr || rate.is_some(), "DRR requires --application-mbps");
+        anyhow::ensure!(
+            session_limit == 0 || max_group > 0,
+            "session budget requires --max-group-bytes"
+        );
+        anyhow::ensure!(
+            global_limit == 0 || max_group > 0,
+            "global budget requires --max-group-bytes"
+        );
+        anyhow::ensure!(
+            session_limit == 0
+                || max_group
+                    .checked_mul(2)
+                    .is_some_and(|minimum| session_limit >= minimum),
+            "session budget must fit a cache slot and one forwarding group"
+        );
+        anyhow::ensure!(
+            global_limit == 0 || global_limit >= max_group,
+            "global budget must fit a group"
+        );
+        let global = (max_group > 0).then(|| {
+            ByteBudget::new(global_limit).with_observer(Arc::new(|current, peak, rejections| {
+                metrics::gauge!("moq_relay_global_reserved_bytes").set(current as f64);
+                metrics::gauge!("moq_relay_global_peak_reserved_bytes").set(peak as f64);
+                metrics::gauge!("moq_relay_global_admission_rejections").set(rejections as f64);
+            }))
+        });
+        Ok(Self {
+            scheduler: rate.map(|r| Scheduler::new(r, drr)),
+            global,
+            session_limit,
+            max_group,
+        })
+    }
+    pub fn session(&self, id: String) -> (Option<SharedWritePolicy>, Option<(ByteBudget, usize)>) {
+        let policy = self.scheduler.as_ref().map(|s| s.session(id.clone()));
+        // Track unbounded baseline reservations too, whenever a group bound is set.
+        let budget = (self.max_group > 0).then(|| {
+            let b = ByteBudget::new(self.session_limit).with_observer(Arc::new(
+                move |current, peak, rejections| {
+                    metrics::gauge!("moq_relay_session_reserved_bytes", "session"=>id.clone())
+                        .set(current as f64);
+                    metrics::gauge!("moq_relay_session_peak_reserved_bytes", "session"=>id.clone())
+                        .set(peak as f64);
+                    metrics::gauge!("moq_relay_session_budget_rejections", "session"=>id.clone())
+                        .set(rejections as f64);
+                },
+            ));
+            (b, self.max_group)
+        });
+        (policy, budget)
+    }
+    pub fn receiving(&self, subscriber: &Subscriber) {
+        if self.max_group > 0 {
+            subscriber.set_payload_budget(self.max_group, self.global.clone());
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn configuration_cannot_claim_a_cap_without_bounded_groups() {
+        assert!(Resources::new(None, false, 100, 0, 0).is_err());
+        assert!(Resources::new(None, false, 0, 100, 0).is_err());
+        assert!(Resources::new(None, false, 199, 0, 100).is_err());
+        assert!(Resources::new(None, false, 0, 99, 100).is_err());
+        assert!(Resources::new(None, true, 0, 0, 0).is_err());
+        assert!(Resources::new(Some(0), false, 0, 0, 0).is_err());
+        assert!(Resources::new(None, false, usize::MAX, 0, usize::MAX).is_err());
+        assert!(Resources::new(None, false, 200, 100, 100).is_ok());
+    }
+
+    #[test]
+    fn two_subscriptions_share_one_session_budget_but_not_another_sessions_budget() {
+        let resources = Resources::new(None, false, 300, 1000, 100).unwrap();
+        // Producer constructs this session handle once, then clones it for
+        // subscriptions. Each subscription needs a latest-cache slot and an
+        // active-group slot; allocating them independently must not reset it.
+        let (_, first) = resources.session("first".into());
+        let (session, maximum) = first.unwrap();
+        let second_subscription = session.clone();
+        let first_cache = session.try_reserve(maximum).unwrap();
+        let first_group = session.try_reserve(maximum).unwrap();
+        let second_cache = second_subscription.try_reserve(maximum).unwrap();
+        assert!(second_subscription.try_reserve(maximum).is_err());
+        assert_eq!(session.current(), 300);
+        assert_eq!(session.rejections(), 1);
+        let (_, other) = resources.session("other".into());
+        let (other, _) = other.unwrap();
+        let other_cache = other.try_reserve(maximum).unwrap();
+        let other_group = other.try_reserve(maximum).unwrap();
+        assert_eq!(other.current(), 200);
+        drop(first_group);
+        let recovered_group = second_subscription.try_reserve(maximum).unwrap();
+        assert_eq!(session.peak(), 300);
+        drop((first_cache, second_cache, recovered_group));
+        assert_eq!(session.current(), 0);
+        assert_eq!(other.current(), 200);
+        drop((other_cache, other_group));
+        assert_eq!(other.current(), 0);
+    }
+
+    #[test]
+    fn global_admission_and_session_reference_accounting_are_separate() {
+        let resources = Resources::new(None, false, 200, 100, 100).unwrap();
+        let global = resources.global.as_ref().unwrap();
+        let shared_group = Arc::new(global.try_reserve(100).unwrap());
+        let another_reader = shared_group.clone();
+        let (_, session_a) = resources.session("a".into());
+        let (_, session_b) = resources.session("b".into());
+        let (session_a, maximum) = session_a.unwrap();
+        let (session_b, _) = session_b.unwrap();
+        let first_reference = session_a.try_reserve(maximum).unwrap();
+        let second_reference = session_b.try_reserve(maximum).unwrap();
+        assert_eq!(global.current(), 100);
+        assert_eq!(session_a.current() + session_b.current(), 200);
+        assert!(global.try_reserve(100).is_err());
+        drop((shared_group, first_reference));
+        assert_eq!(global.current(), 100);
+        drop((another_reader, second_reference));
+        assert_eq!(global.current(), 0);
+    }
+}
