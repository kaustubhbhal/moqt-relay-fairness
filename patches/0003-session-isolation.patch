+// SPDX-FileCopyrightText: 2026 MoQT Relay Fairness project contributors
+// SPDX-License-Identifier: MIT OR Apache-2.0
+
+//! Checked byte reservations selected by an embedder, without a transport policy.
+
+use std::sync::{
+    atomic::{AtomicUsize, Ordering},
+    Arc, Mutex,
+};
+
+use super::ServeError;
+
+#[derive(Clone)]
+pub struct ByteBudget {
+    inner: Arc<BudgetState>,
+}
+
+type Observer = Arc<dyn Fn(usize, usize, u64) + Send + Sync>;
+
+struct BudgetState {
+    limit: usize,
+    current: AtomicUsize,
+    peak: AtomicUsize,
+    rejections: AtomicUsize,
+    observer: Mutex<Option<Observer>>,
+    notification: Mutex<()>,
+}
+
+impl ByteBudget {
+    /// A zero limit records reservations without imposing a configured cap.
+    pub fn new(limit: usize) -> Self {
+        Self {
+            inner: Arc::new(BudgetState {
+                limit,
+                current: AtomicUsize::new(0),
+                peak: AtomicUsize::new(0),
+                rejections: AtomicUsize::new(0),
+                observer: Mutex::new(None),
+                notification: Mutex::new(()),
+            }),
+        }
+    }
+
+    /// Install a shared observer and publish an initial snapshot. Callbacks are
+    /// serialized and run without an admission/accounting lock. They must not
+    /// mutate this same budget or replace its observer (notification reentry).
+    pub fn with_observer(self, observer: Observer) -> Self {
+        *self.inner.observer.lock().unwrap() = Some(observer);
+        self.notify();
+        self
+    }
+
+    fn notify(&self) {
+        // Serial delivery prevents an old, delayed snapshot from overwriting
+        // a newer metric. Read counters only after taking the delivery lock.
+        let _delivery = self.inner.notification.lock().unwrap();
+        let observer = self.inner.observer.lock().unwrap().clone();
+        if let Some(observer) = observer {
+            let current = self.current();
+            // A concurrent reservation may have published current but not yet
+            // updated peak. Persist the observed maximum so a later release
+            // notification cannot make the reported peak move backwards.
+            self.inner.peak.fetch_max(current, Ordering::Relaxed);
+            observer(current, self.peak(), self.rejections() as u64);
+        }
+    }
+
+    /// Reserve before retaining data. Failure does not change the live charge.
+    /// The embedder maps Size to its chosen admission/eviction response.
+    pub fn try_reserve(&self, bytes: usize) -> Result<BudgetLease, ServeError> {
+        let mut current = self.inner.current.load(Ordering::Acquire);
+        loop {
+            let Some(next) = current.checked_add(bytes) else {
+                self.inner.rejections.fetch_add(1, Ordering::Relaxed);
+                self.notify();
+                return Err(ServeError::Size);
+            };
+            if self.inner.limit != 0 && next > self.inner.limit {
+                self.inner.rejections.fetch_add(1, Ordering::Relaxed);
+                self.notify();
+                return Err(ServeError::Size);
+            }
+            match self.inner.current.compare_exchange_weak(
+                current,
+                next,
+                Ordering::AcqRel,
+                Ordering::Acquire,
+            ) {
+                Ok(_) => {
+                    self.inner.peak.fetch_max(next, Ordering::Relaxed);
+                    self.notify();
+                    return Ok(BudgetLease {
+                        budget: self.clone(),
+                        bytes,
+                    });
+                }
+                Err(observed) => current = observed,
+            }
+        }
+    }
+
+    pub fn limit(&self) -> usize {
+        self.inner.limit
+    }
+
+    pub fn current(&self) -> usize {
+        self.inner.current.load(Ordering::Acquire)
+    }
+
+    pub fn peak(&self) -> usize {
+        self.inner.peak.load(Ordering::Relaxed)
+    }
+
+    pub fn rejections(&self) -> usize {
+        self.inner.rejections.load(Ordering::Relaxed)
+    }
+}
+
+impl std::fmt::Debug for ByteBudget {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("ByteBudget")
+            .field("limit", &self.limit())
+            .field("current", &self.current())
+            .field("peak", &self.peak())
+            .field("rejections", &self.rejections())
+            .finish()
+    }
+}
+
+/// Releases exactly once. Use Arc<BudgetLease> when several owners retain the
+/// same allocation; cloning the Arc does not reserve the bytes again.
+#[derive(Debug)]
+pub struct BudgetLease {
+    budget: ByteBudget,
+    bytes: usize,
+}
+
+impl BudgetLease {
+    pub fn bytes(&self) -> usize {
+        self.bytes
+    }
+}
+
+impl Drop for BudgetLease {
+    fn drop(&mut self) {
+        let previous = self
+            .budget
+            .inner
+            .current
+            .fetch_sub(self.bytes, Ordering::AcqRel);
+        debug_assert!(previous >= self.bytes, "reservation accounting underflow");
+        self.budget.notify();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn observer_tracks_admission_rejection_and_release_from_clones() {
+        let snapshots = Arc::new(Mutex::new(Vec::new()));
+        let captured = snapshots.clone();
+        let budget = ByteBudget::new(8).with_observer(Arc::new(move |current, peak, rejected| {
+            captured.lock().unwrap().push((current, peak, rejected));
+        }));
+        let shared = budget.clone();
+        let lease = shared.try_reserve(8).unwrap();
+        assert!(budget.try_reserve(1).is_err());
+        drop(lease);
+        assert_eq!(
+            *snapshots.lock().unwrap(),
+            vec![(0, 0, 0), (8, 8, 0), (8, 8, 1), (0, 8, 1)]
+        );
+    }
+
+    #[test]
+    fn observer_persists_peak_during_a_partially_published_reservation() {
+        let snapshots = Arc::new(Mutex::new(Vec::new()));
+        let captured = snapshots.clone();
+        let budget =
+            ByteBudget::new(100).with_observer(Arc::new(move |current, peak, rejected| {
+                captured.lock().unwrap().push((current, peak, rejected));
+            }));
+        // Model a reserving thread paused after its successful current CAS,
+        // before it performs fetch_max on peak.
+        budget.inner.current.store(100, Ordering::Release);
+        budget.notify();
+        assert_eq!(budget.peak(), 100);
+        budget.inner.current.store(0, Ordering::Release);
+        budget.notify();
+        assert_eq!(
+            *snapshots.lock().unwrap(),
+            vec![(0, 0, 0), (100, 100, 0), (0, 100, 0)]
+        );
+    }
+
+    #[test]
+    fn exact_limit_rejects_without_charging_and_releases() {
+        let budget = ByteBudget::new(100);
+        let first = budget.try_reserve(40).unwrap();
+        let second = budget.try_reserve(60).unwrap();
+        assert_eq!(budget.current(), 100);
+        assert_eq!(budget.try_reserve(1).unwrap_err(), ServeError::Size);
+        assert_eq!(budget.current(), 100);
+        assert_eq!(budget.rejections(), 1);
+        drop(first);
+        assert_eq!(budget.current(), 60);
+        drop(second);
+        assert_eq!(budget.current(), 0);
+        assert_eq!(budget.peak(), 100);
+    }
+
+    #[test]
+    fn shared_owner_is_charged_once_until_last_drop() {
+        let budget = ByteBudget::new(9);
+        let lease = Arc::new(budget.try_reserve(9).unwrap());
+        let second = lease.clone();
+        drop(lease);
+        assert_eq!(budget.current(), 9);
+        drop(second);
+        assert_eq!(budget.current(), 0);
+    }
+
+    #[test]
+    fn unlimited_tracking_still_rejects_integer_overflow() {
+        let budget = ByteBudget::new(0);
+        let lease = budget.try_reserve(usize::MAX).unwrap();
+        assert!(budget.try_reserve(1).is_err());
+        assert_eq!(budget.current(), usize::MAX);
+        drop(lease);
+        assert_eq!(budget.current(), 0);
+    }
+
+    #[test]
+    fn concurrent_reservations_never_exceed_the_limit() {
+        use std::{sync::Barrier, thread};
+        let budget = ByteBudget::new(64);
+        let barrier = Arc::new(Barrier::new(9));
+        let threads: Vec<_> = (0..8)
+            .map(|_| {
+                let budget = budget.clone();
+                let barrier = barrier.clone();
+                thread::spawn(move || {
+                    let lease = budget.try_reserve(16);
+                    barrier.wait();
+                    barrier.wait();
+                    drop(lease);
+                })
+            })
+            .collect();
+        barrier.wait();
+        assert_eq!(budget.current(), 64);
+        assert_eq!(budget.peak(), 64);
+        assert_eq!(budget.rejections(), 4);
+        barrier.wait();
+        for handle in threads {
+            handle.join().unwrap();
+        }
+        assert_eq!(budget.current(), 0);
+    }
+
+    #[tokio::test]
+    async fn cancelled_task_releases_its_reservation() {
+        let budget = ByteBudget::new(128);
+        let held = budget.clone();
+        let (ready, waiting) = tokio::sync::oneshot::channel();
+        let task = tokio::spawn(async move {
+            let _lease = held.try_reserve(128).unwrap();
+            ready.send(()).unwrap();
+            std::future::pending::<()>().await;
+        });
+        waiting.await.unwrap();
+        assert_eq!(budget.current(), 128);
+        task.abort();
+        assert!(task.await.unwrap_err().is_cancelled());
+        assert_eq!(budget.current(), 0);
+    }
+}
