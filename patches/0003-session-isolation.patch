+        let sender: web_transport::Session = wt::Session::raw(
+            sender.unwrap(),
+            url.clone(),
+            wt::proto::ConnectResponse::default(),
+        )
+        .into();
+        let receiver: web_transport::Session = wt::Session::raw(
+            receiver.unwrap(),
+            url,
+            wt::proto::ConnectResponse::default(),
+        )
+        .into();
+        let mut send = sender.open_uni().await.unwrap();
+        let mut remaining = payload;
+        while !remaining.is_empty() {
+            let written = send.write(remaining).await.unwrap();
+            assert_ne!(written, 0);
+            remaining = &remaining[written..];
+        }
+        let stream = tokio::time::timeout(Duration::from_secs(3), receiver.accept_uni())
+            .await
+            .unwrap()
+            .unwrap();
+        let info = serve::SubgroupInfo {
+            track: Arc::new(serve::Track::new(
+                TrackNamespace::from_utf8_path("reset-test"),
+                "video",
+            )),
+            group_id: 1,
+            subgroup_id: 0,
+            priority: 128,
+        };
+        let (writer, subgroup) = info.produce();
+        let mut writer = Some(writer);
+        let header = data::SubgroupHeader {
+            header_type: data::StreamHeaderType::SubgroupId,
+            track_alias: 0,
+            group_id: 1,
+            subgroup_id: Some(0),
+            publisher_priority: 128,
+        };
+        let session_id = SessionId::generate();
+        let reader = Reader::new(session_id.clone(), stream);
+        let task = tokio::spawn(Subscriber::recv_subgroup_objects(
+            session_id,
+            header.header_type,
+            header,
+            reader,
+            None,
+            move |_| writer.take().ok_or(SessionError::Internal),
+        ));
+        Incoming {
+            send,
+            task,
+            subgroup,
+            _sessions: (sender, receiver),
+            _endpoints: (server, client),
+        }
+    }
+
+    async fn receive_error(
+        task: &mut tokio::task::JoinHandle<Result<(), SessionError>>,
+    ) -> SessionError {
+        tokio::time::timeout(Duration::from_secs(3), task)
+            .await
+            .unwrap()
+            .unwrap()
+            .unwrap_err()
+    }
+
+    #[tokio::test]
+    async fn actual_reset_during_partial_object_preserves_code() {
+        for code in [2, 18] {
+            // Delta=0, promised length=4, only one payload byte supplied.
+            let mut input = incoming(&[0, 4, b'a']).await;
+            let mut object = tokio::time::timeout(Duration::from_secs(3), input.subgroup.next())
+                .await
+                .unwrap()
+                .unwrap()
+                .unwrap();
+            assert_eq!(
+                object.read().await.unwrap().unwrap(),
+                Bytes::from_static(b"a")
+            );
+            input.send.reset(code);
+            let error = receive_error(&mut input.task).await;
+            assert_eq!(data_stream_reset_code(&error), Some(code));
+            assert!(error.is_stream_error());
+            assert_eq!(
+                object.read_all().await.unwrap_err(),
+                ServeError::Reset(code)
+            );
+            assert_eq!(
+                input.subgroup.read_next().await.unwrap_err(),
+                ServeError::Reset(code)
+            );
+        }
+    }
+
+    #[tokio::test]
+    async fn actual_reset_after_complete_object_and_inside_next_header() {
+        for payload in [&[0, 1, b'a'][..], &[0, 1, b'a', 0x40][..]] {
+            // 0x40 starts a two-byte varint but omits its second byte.
+            let mut input = incoming(payload).await;
+            let complete = tokio::time::timeout(Duration::from_secs(3), input.subgroup.read_next())
+                .await
+                .unwrap()
+                .unwrap()
+                .unwrap();
+            assert_eq!(complete, Bytes::from_static(b"a"));
+            input.send.reset(2);
+            assert_eq!(
+                data_stream_reset_code(&receive_error(&mut input.task).await),
+                Some(2)
+            );
+            assert_eq!(
+                input.subgroup.read_next().await.unwrap_err(),
+                ServeError::Reset(2)
+            );
+        }
+    }
+
+    #[tokio::test]
+    async fn actual_fin_truncation_remains_size_error_not_reset() {
+        let mut input = incoming(&[0, 4, b'a']).await;
+        let mut object = tokio::time::timeout(Duration::from_secs(3), input.subgroup.next())
+            .await
+            .unwrap()
+            .unwrap()
+            .unwrap();
+        assert_eq!(
+            object.read().await.unwrap().unwrap(),
+            Bytes::from_static(b"a")
+        );
+        input.send.finish().unwrap();
+        let error = receive_error(&mut input.task).await;
+        assert!(matches!(error, SessionError::WrongSize));
+        assert_eq!(data_stream_reset_code(&error), None);
+        assert_eq!(object.read_all().await.unwrap_err(), ServeError::Size);
+    }
+
+    #[tokio::test]
+    async fn actual_truncated_or_invalid_header_is_not_reset() {
+        for payload in [&[0, 1, b'a', 0x40][..], &[0, 0, 2][..]] {
+            // The second input is an invalid object-status value, not a reset.
+            let mut input = incoming(payload).await;
+            input.send.finish().unwrap();
+            let error = receive_error(&mut input.task).await;
+            assert!(matches!(error, SessionError::Decode(_)));
+            assert_eq!(data_stream_reset_code(&error), None);
+        }
+    }
+
+    #[test]
+    fn only_a_typed_transport_reset_is_recognized() {
+        for error in [
+            SessionError::WrongSize,
+            SessionError::Serve(ServeError::Closed(2)),
+            SessionError::Serve(ServeError::Reset(2)),
+            SessionError::WebTransport(web_transport::Error::Read(wt::ReadError::ClosedStream)),
+            SessionError::WebTransport(web_transport::Error::Read(wt::ReadError::InvalidReset(
+                2u32.into(),
+            ))),
+        ] {
+            assert_eq!(data_stream_reset_code(&error), None);
+        }
+    }
+}
