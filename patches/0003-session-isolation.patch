+    }
+    #[tokio::test]
+    async fn partial_write_charges_only_accepted_bytes() {
+        let s = Scheduler::new(1_000_000, true);
+        let mut a = s.session("a".into()).stream(0);
+        let w = noop_waker();
+        let mut cx = Context::from_waker(&w);
+        assert!(matches!(
+            a.poll_write(&mut cx, 8192, &mut |_, _| Poll::Ready(Ok(100))),
+            Poll::Ready(Ok(100))
+        ));
+        assert_eq!(s.state.lock().unwrap().flows["a"].deficit, QUANTUM - 100);
+    }
+    #[tokio::test]
+    async fn synchronous_transport_wake_is_not_lost_or_deadlocked() {
+        let s = Scheduler::new(1_000_000, true);
+        let mut a = s.session("a".into()).stream(0);
+        let w = noop_waker();
+        let mut cx = Context::from_waker(&w);
